---
import Layout from '../layouts/Layout.astro';
import { nurseryMeta, nurseryStoryPhotos } from '../data/processedData';
import { getPublicPlantCatalog } from '../lib/publicCatalog';
import { siteUrl } from '../utils/siteUrl';

export const prerender = false;

const { plants: plantCatalog } = await getPublicPlantCatalog();
const featuredPlant = plantCatalog.find((plant) => plant.id === 'swamp-flax') ?? plantCatalog[0];
const sustainabilityPillars = [
	{
		number: '01',
		title: 'Reduce and reuse materials',
		measure: '88–92% less plastic used',
		description: 'Degradable Ellebags, reusable nursery trays and returnable corflute packaging help reduce single-use plastics.',
	},
	{
		number: '02',
		title: 'Measure and manage water',
		measure: 'Water used with care',
		description: 'Roof-water capture, zoned irrigation and monitoring help target water to plant needs and minimise wastage.',
	},
	{
		number: '03',
		title: 'Measure our carbon',
		measure: '9.16 t CO₂-e baseline',
		description: 'We measure our operational footprint and look for practical improvements in transport, delivery and energy efficiency.',
	},
	{
		number: '04',
		title: 'Protect plant health',
		measure: 'Plant Pass audited',
		description: 'Monitored plant-health systems support healthy plants and help protect the environments they are planted into.',
	},
	{
		number: '05',
		title: 'Support restoration',
		measure: 'Grown for the long term',
		description: 'Our natives support riparian and wetland restoration, healthier waterways, erosion control and biodiversity.',
	},
	{
		number: '06',
		title: 'Grow for local conditions',
		measure: 'Locally proven natives',
		description: 'Hardy plants suited to local conditions give restoration and planting projects a better-fit starting point.',
	},
];
---

<Layout title="What makes us different | WaiNot Native Nursery">
	<div class="difference-page">
		<section class="difference-hero" aria-labelledby="difference-title">
			<div class="difference-hero-copy">
				<p class="difference-eyebrow"><span aria-hidden="true"></span> The WaiNot difference · Waikite Valley</p>
				<h1 id="difference-title">Good growing.<br /><em>Wider purpose.</em></h1>
				<p class="difference-lead">We grow hardy native plants with care for the land, the people planting them and the places they’ll grow for generations.</p>
				<a class="difference-button" href="#sustainability">How we make a difference <span aria-hidden="true">↓</span></a>
				<p class="difference-location">Locally grown in Rotorua, Aotearoa</p>
			</div>
			<figure class="difference-hero-image">
				<img
					src="https://dzpdbgwih7u1r.cloudfront.net/9aa59b48-85ec-4aad-8748-d7131ea253b0/a11b26df-c430-4dbb-8acc-e0c6a32309b5/a11b26df-c448-46dc-a6d9-6d11d2bfd881/w3024h3024-20230727_164422.jpg"
					alt="A native plant grown in its degradable Ellebag sleeve"
					width="3024"
					height="3024"
					fetchpriority="high"
				/>
				<figcaption>Thoughtful growing, from nursery to planting site.</figcaption>
			</figure>
		</section>

		<section class="difference-purpose" aria-label="Our purpose">
			<p>Every plant has a job to do: restoring waterways, establishing wetlands and strengthening native habitats across landscapes and communities.</p>
			<a href={siteUrl('#catalogue')}>Explore our plants <span aria-hidden="true">↗</span></a>
		</section>

		<section id="sustainability" class="sustainability-section" aria-labelledby="sustainability-title">
			<header class="difference-section-heading">
				<div>
					<p class="difference-eyebrow">Sustainability, climate action &amp; kaitiakitanga</p>
					<h2 id="sustainability-title">Better choices,<br /><em>at every stage.</em></h2>
				</div>
				<p>Our environmental impact goes beyond the nursery gate. We keep reviewing how we grow, use resources and deliver plants—and make practical improvements where we can.</p>
			</header>

			<div class="pillar-grid">
				{ sustainabilityPillars.map((pillar) => (
					<article class="pillar-card">
						<span class="pillar-number">{pillar.number}</span>
						<h3>{pillar.title}</h3>
						<p class="pillar-measure">{pillar.measure}</p>
						<p class="pillar-description">{pillar.description}</p>
					</article>
				)) }
			</div>
			<p class="sustainability-note">Sustainability is an ongoing process: we keep measuring, learning and improving to supply quality plants that can do their job in the environment for years to come.</p>
		</section>

		<section class="growing-story" aria-labelledby="growing-title">
			<div class="growing-story-image">
				{featuredPlant && <img
					src={featuredPlant.image}
					alt={featuredPlant.image_alt}
					width="960"
					height="960"
					loading="lazy"
					decoding="async"
				/>}
				<span>Grown for landscapes and communities</span>
			</div>
			<div class="growing-story-copy">
				<p class="difference-eyebrow">Growing natives with a wider purpose</p>
				<h2 id="growing-title">From our nursery<br />to <em>your whenua.</em></h2>
				<p>We have looked closely at every stage of our growing and supply system. Single-use plastic plant pots and trays are no longer part of it: nursery trays are retained and reused, while corflute delivery boxes can be returned and recycled.</p>
				<p>We monitor water use and our operational carbon footprint, and continually improve how plants are grown, packed and delivered. Technology helps us make informed decisions about plant health, watering and nutrients.</p>
				<p class="growing-emphasis">For us, kaitiakitanga means caring for our environment here at the nursery while producing plants that help establish successful native landscapes beyond our gate.</p>
				<a class="difference-text-link" href={siteUrl('#ellebag')}>Discover how we grow <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="difference-photo-section" aria-labelledby="difference-photo-title">
			<header>
				<p class="difference-eyebrow">The people and place behind the plants</p>
				<h2 id="difference-photo-title">Grown with care,<br /><em>from the ground up.</em></h2>
			</header>
			<div class="nursery-photo-grid">
				{nurseryStoryPhotos.map((photo) => (
					<figure class={`nursery-photo-card nursery-photo-card--${photo.id}`}>
						<img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
						<figcaption><span>{photo.caption}</span><span aria-hidden="true">↗</span></figcaption>
					</figure>
				))}
			</div>
		</section>

		<section class="about-nursery" aria-labelledby="about-title">
			<div class="about-nursery-heading">
				<p class="difference-eyebrow">Rooted in Waikite Valley</p>
				<h2 id="about-title">A bit about<br /><em>WaiNot.</em></h2>
			</div>
			<div class="about-nursery-copy">
				<p>WaiNot Native Nursery is owned and operated by Steve and Steph Carroll in Waikite Valley, near Rotorua. After dairy farming in the district until 2018, they built a new business around native plants, practical growing systems and their connection to the land.</p>
				<p>We use the Ellebag growing system developed by Danish propagation specialists Ellepot A/S. Our on-site Ellebag machine lets us produce and fill degradable bags at the nursery. Most of our plants are grown in 60 mm Ellebags, with 80 mm and 100 mm sizes also available.</p>
				<a class="difference-text-link" href={`mailto:${nurseryMeta.email}?subject=Native%20plant%20enquiry`}>Talk with the nursery <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<aside class="difference-cta" aria-labelledby="difference-cta-title">
			<div>
				<p class="difference-eyebrow">Your next planting starts here</p>
				<h2 id="difference-cta-title">Let’s grow something good.</h2>
			</div>
			<a class="difference-button difference-button-light" href={siteUrl('#contact')}>Plan your project <span aria-hidden="true">↗</span></a>
		</aside>
	</div>
</Layout>

<style>
	.difference-page {
		--diff-ink: #1d3229;
		--diff-forest: #244437;
		--diff-sage: #829477;
		--diff-cream: #f5f4ee;
		--diff-paper: #fcfbf7;
		--diff-line: rgba(29, 50, 41, .15);
		color: var(--diff-ink);
		background: var(--diff-paper);
	}

	.difference-hero {
		min-height: 560px;
		padding: clamp(64px, 8vw, 110px) var(--gutter);
		display: grid;
		grid-template-columns: 1fr .83fr;
		align-items: center;
		gap: clamp(40px, 7vw, 100px);
		background: var(--diff-cream);
	}
	.difference-hero-copy { max-width: 600px; }
	.difference-eyebrow {
		margin: 0 0 20px;
		color: #687d64;
		font-size: .75rem;
		font-weight: 700;
		letter-spacing: .16em;
		line-height: 1.5;
		text-transform: uppercase;
	}
	.difference-hero .difference-eyebrow > span {
		display: inline-block;
		width: 7px;
		height: 7px;
		margin: 0 8px 1px 0;
		border-radius: 50%;
		background: var(--diff-sage);
	}
	.difference-hero h1, .difference-section-heading h2, .growing-story h2, .about-nursery h2, .difference-cta h2 {
		margin: 0;
		font-family: "Playfair Display", Georgia, serif;
		font-weight: 500;
		letter-spacing: -.055em;
		line-height: 1.02;
	}
	.difference-hero h1 { font-size: clamp(3.25rem, 6.4vw, 5.8rem); }
	.difference-hero h1 em, .difference-section-heading h2 em, .growing-story h2 em, .about-nursery h2 em {
		color: var(--diff-sage);
		font-weight: 400;
	}
	.difference-lead {
		max-width: 465px;
		margin: 25px 0 28px;
		color: #65736a;
		font-size: 1.0625rem;
		line-height: 1.8;
	}
	.difference-button {
		min-height: 50px;
		padding: 0 21px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		border-radius: 3px;
		box-shadow: 0 7px 18px rgba(36, 68, 55, .13);
		background: var(--diff-forest);
		color: white;
		font-size: .875rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform .2s ease, background .2s ease;
	}
	.difference-button:hover { transform: translateY(-2px); background: #192f25; }
	.difference-location {
		margin: 37px 0 0;
		padding-top: 16px;
		border-top: 1px solid var(--diff-line);
		color: #68736a;
		font-size: .75rem;
		letter-spacing: .07em;
		text-transform: uppercase;
	}
	.difference-hero-image {
		position: relative;
		width: 100%;
		max-width: 520px;
		height: 430px;
		margin: 0;
		justify-self: end;
		background: #d9e0d1;
	}
	.difference-hero-image::before {
		position: absolute;
		top: -16px;
		right: -16px;
		width: 38%;
		height: 48%;
		content: "";
		background: #d9e0d1;
	}
	.difference-hero-image img {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 64%;
	}
	.difference-hero-image figcaption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		padding: 40px 18px 16px;
		background: linear-gradient(transparent, rgba(20, 39, 29, .74));
		color: white;
		font-size: .75rem;
		letter-spacing: .04em;
	}

	.difference-purpose {
		padding: 31px var(--gutter);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		background: var(--diff-forest);
		color: white;
	}
	.difference-purpose p {
		max-width: 800px;
		margin: 0;
		font-family: "Playfair Display", Georgia, serif;
		font-size: clamp(1.125rem, 2vw, 1.5rem);
		line-height: 1.55;
	}
	.difference-purpose a {
		flex: none;
		color: #d5e0ca;
		font-size: .8125rem;
		font-weight: 600;
		text-decoration: none;
	}
	.difference-purpose a:hover { color: white; }
	.difference-purpose a span { margin-left: 5px; }

	.difference-photo-section {
		padding: var(--section-y) var(--gutter);
		background: #f4f4ed;
	}
	.difference-photo-section > header {
		margin-bottom: 32px;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 30px;
	}
	.difference-photo-section .difference-eyebrow { margin-bottom: 13px; }
	.difference-photo-section h2 {
		margin: 0;
		font-family: "Playfair Display", Georgia, serif;
		font-size: clamp(2.5rem, 4.8vw, 3.75rem);
		font-weight: 500;
		letter-spacing: -.05em;
		line-height: 1.04;
	}
	.difference-photo-section h2 em { color: var(--diff-sage); font-weight: 400; }

	.sustainability-section { padding: var(--section-y) var(--gutter); }
	.difference-section-heading {
		margin-bottom: 40px;
		display: grid;
		grid-template-columns: 1fr minmax(260px, .52fr);
		align-items: end;
		gap: 48px;
	}
	.difference-section-heading .difference-eyebrow { margin-bottom: 14px; }
	.difference-section-heading h2, .growing-story h2, .about-nursery h2 { font-size: var(--h2-size); }
	.difference-section-heading > p {
		position: relative;
		max-width: 440px;
		margin: 0 0 6px;
		padding-left: 20px;
		border-left: 1px solid #d8e0d2;
		color: #5f6e64;
		font-size: .9375rem;
		line-height: 1.75;
	}
	.difference-section-heading > p::before {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: -2px;
		width: 3px;
		border-radius: 999px;
		background: #829477;
		content: "";
	}
	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
	}
	.pillar-card {
		position: relative;
		min-height: 250px;
		padding: 24px 22px;
		border-radius: 3px;
		border: 1px solid var(--diff-line);
		background: linear-gradient(145deg, #fff 0%, #fbfcf8 100%);
		box-shadow: 0 4px 16px rgba(29, 50, 41, .035);
		transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
	}
	.pillar-card:hover {
		transform: translateY(-2px);
		border-color: #cbd5c4;
		box-shadow: 0 10px 24px rgba(29, 50, 41, .075);
	}
	.pillar-number {
		width: 34px;
		height: 34px;
		display: inline-grid;
		place-items: center;
		border: 1px solid #e1e7dc;
		border-radius: 50%;
		background: #f5f7f1;
		color: #829477;
		font-family: "Playfair Display", Georgia, serif;
		font-size: .875rem;
		font-style: italic;
	}
	.pillar-card h3 {
		margin: 21px 0 9px;
		font-family: "Playfair Display", Georgia, serif;
		font-size: 1.375rem;
		font-weight: 500;
		letter-spacing: -.025em;
		line-height: 1.25;
	}
	.pillar-measure {
		margin: 0;
		color: #728368;
		font-size: .75rem;
		font-weight: 700;
		letter-spacing: .04em;
		text-transform: uppercase;
	}
	.pillar-description {
		margin: 13px 0 0;
		color: #68746b;
		font-size: .8125rem;
		line-height: 1.7;
	}
	.sustainability-note {
		position: relative;
		max-width: 820px;
		margin: 38px auto 0;
		padding: 21px 28px 21px 60px;
		border: 1px solid #dce3d6;
		border-left: 3px solid #829477;
		border-radius: 3px;
		background: linear-gradient(110deg, #f1f4ed, #f8f8f3);
		box-shadow: 0 5px 18px rgba(29, 50, 41, .04);
		color: #536459;
		font-size: .875rem;
		line-height: 1.8;
	}
	.sustainability-note::before {
		position: absolute;
		top: 50%;
		left: 23px;
		width: 15px;
		height: 11px;
		border: 1.5px solid #829477;
		border-radius: 100% 0 100% 0;
		content: "";
		transform: translateY(-60%) rotate(-25deg);
	}
	.sustainability-note::after {
		position: absolute;
		top: 50%;
		left: 25px;
		width: 12px;
		height: 1px;
		background: #829477;
		content: "";
		transform: translateY(2px) rotate(-39deg);
	}

	.growing-story {
		padding: var(--section-y) var(--gutter);
		display: grid;
		grid-template-columns: minmax(0, .92fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(42px, 7vw, 100px);
		background: #eeeee6;
	}
	.growing-story-image { position: relative; min-height: 440px; }
	.growing-story-image::after {
		position: absolute;
		right: -13px;
		bottom: -13px;
		width: 58%;
		height: 55%;
		content: "";
		background: #d8dfd0;
	}
	.growing-story-image img {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: 440px;
		object-fit: cover;
	}
	.growing-story-image span {
		position: absolute;
		z-index: 2;
		bottom: 0;
		left: 0;
		padding: 40px 18px 16px;
		width: 100%;
		background: linear-gradient(transparent, rgba(20, 39, 29, .72));
		color: white;
		font-size: .75rem;
		font-weight: 600;
		letter-spacing: .08em;
		text-transform: uppercase;
	}
	.growing-story-copy { max-width: 560px; }
	.growing-story-copy > p:not(.difference-eyebrow) {
		color: #5f6e64;
		font-size: .875rem;
		line-height: 1.85;
	}
	.growing-story-copy .difference-eyebrow { margin-bottom: 14px; }
	.growing-story-copy h2 { margin-bottom: 21px; }
	.growing-story-copy .growing-emphasis { color: var(--diff-forest); font-weight: 600; }
	.difference-text-link {
		display: inline-block;
		margin-top: 10px;
		padding-bottom: 5px;
		border-bottom: 1px solid #a7b19e;
		color: var(--diff-ink);
		font-size: .875rem;
		font-weight: 600;
		text-decoration: none;
	}
	.difference-text-link:hover { color: #829477; }
	.difference-text-link span { margin-left: 7px; }

	.about-nursery {
		padding: var(--section-y) var(--gutter);
		display: grid;
		grid-template-columns: .75fr 1fr;
		gap: clamp(40px, 8vw, 110px);
		background: var(--diff-paper);
	}
	.about-nursery-heading .difference-eyebrow { margin-bottom: 14px; }
	.about-nursery-copy { max-width: 620px; }
	.about-nursery-copy p {
		margin: 0 0 17px;
		color: #5f6e64;
		font-size: .875rem;
		line-height: 1.85;
	}

	.difference-cta {
		padding: 44px var(--gutter);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		background: #263f33;
		color: white;
	}
	.difference-cta .difference-eyebrow { margin-bottom: 10px; color: #bdcbaa; }
	.difference-cta h2 { font-size: clamp(1.75rem, 3.4vw, 2.75rem); }
	.difference-button-light { flex: none; background: #f0f1e9; color: var(--diff-forest); }
	.difference-button-light:hover { background: white; }

	@media (max-width: 800px) {
		.difference-hero { grid-template-columns: 1fr .8fr; 		gap: 34px; }
				.difference-hero h1 { font-size: clamp(3rem, 7vw, 4.25rem); }
				.difference-hero-image { height: 380px; }
				.difference-section-heading { grid-template-columns: 1fr minmax(230px, .7fr); gap: 28px; }
		.pillar-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.pillar-card { padding: 20px 16px; }
		.pillar-card h3 { font-size: 1.25rem; }
		.growing-story { gap: 46px; }
				.growing-story-image, .growing-story-image img { min-height: 380px; height: 380px; }
			}
	@media (max-width: 640px) {
		.difference-hero { padding: 54px var(--gutter) 45px; grid-template-columns: 1fr; gap: 34px; }
		.difference-hero h1 { font-size: clamp(3rem, 13vw, 4.25rem); }
		.difference-lead { margin: 19px 0 23px; font-size: 1rem; }
		.difference-location { margin-top: 28px; }
		.difference-hero-image { width: calc(100% - 12px); height: min(105vw, 420px); margin-right: 12px; justify-self: start; }
		.difference-hero-image::before { right: -12px; }
		.difference-purpose { padding: 25px var(--gutter); align-items: flex-start; flex-direction: column; gap: 15px; }
		.difference-photo-section { padding: var(--section-y) var(--gutter); }
		.difference-photo-section > header { margin-bottom: 24px; align-items: flex-start; flex-direction: column; gap: 0; }
		.difference-photo-section h2 { font-size: clamp(2.375rem, 10vw, 3rem); }
		.sustainability-section { padding: var(--section-y) var(--gutter); }
		.difference-section-heading { margin-bottom: 27px; grid-template-columns: 1fr; gap: 12px; }
		.difference-section-heading h2, .growing-story h2, .about-nursery h2 { font-size: clamp(2.5rem, 11vw, 3.25rem); }
		.pillar-grid { grid-template-columns: 1fr; gap: 10px; }
		.pillar-card { min-height: 0; padding: 19px; grid-column: auto; }
		.pillar-card h3 { margin-top: 15px; }
		.sustainability-note { margin-top: 25px; padding: 18px 18px 18px 48px; }
		.sustainability-note::before { left: 17px; }
		.sustainability-note::after { left: 19px; }
		.growing-story { padding: var(--section-y) var(--gutter); grid-template-columns: 1fr; gap: 36px; }
		.growing-story-image, .growing-story-image img { min-height: 0; height: min(92vw, 380px); }
		.about-nursery { padding: var(--section-y) var(--gutter); grid-template-columns: 1fr; gap: 23px; }
		.difference-cta { padding: 35px var(--gutter); align-items: flex-start; flex-direction: column; gap: 20px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.difference-button { transition: none; }
		.difference-button:hover { transform: none; }
	}
</style>
