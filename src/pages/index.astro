---
import Layout from '../layouts/Layout.astro';
import { nurseryMeta, nurseryStoryPhotos, plantCatalog, plantCategories, testimonials } from '../data/processedData';
import { siteUrl } from '../utils/siteUrl';

const categoryId = (name: string) => `plants-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<Layout title="WaiNot Native Nursery | Native plants, grown for Aotearoa">
	<div class="nursery-home">
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow"><span class="eyebrow-dot"></span> Rotorua-grown native plants</p>
				<h1 id="hero-title">Rooted here.<br /><em>Growing everywhere.</em></h1>
				<p class="hero-intro">Hardy, locally proven natives for restoration, riparian planting and the landscapes we share.</p>
				<div class="hero-actions">
					<a class="button button-dark" href="#catalogue">Explore the plant range <span aria-hidden="true">↓</span></a>
					<a class="text-link" href="#ellebag">Why Ellebags? <span aria-hidden="true">↗</span></a>
				</div>
				<div class="hero-proof">
					<span class="proof-number">250,000<span>+</span></span>
					<span class="proof-copy">native plants supplied<br />across Aotearoa</span>
					<span class="proof-divider"></span>
					<span class="proof-note">Grown with care<br />in Waikite Valley</span>
				</div>
			</div>
			<div class="hero-visual">
				<img
					class="hero-photo"
					src={plantCatalog.find((plant) => plant.id === 'swamp-flax')?.image}
					alt="Harakeke flax, a hardy native for wetlands and riparian planting"
					width="960"
					height="960"
					fetchpriority="high"
				/>
				<div class="photo-caption"><span>Harakeke</span><span>Locally proven. Naturally resilient.</span></div>
				<div class="photo-stamp" aria-hidden="true">
					<svg viewBox="0 0 100 100"><defs><path id="stamp-circle" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0" /></defs><text><textPath href="#stamp-circle">GROWN IN ROTORUA · MADE FOR AOTEAROA · </textPath></text></svg>
					<span>W</span>
				</div>
			</div>
		</section>

		<section class="ticker" aria-label="Nursery highlights">
			<div><span>01</span><span class="ticker-label">Hardy, local varieties</span></div>
			<div><span>02</span><span class="ticker-label">Degradable Ellebag growing</span></div>
			<div><span>03</span><span class="ticker-label">Plant Pass certified</span></div>
			<div><span>04</span><span class="ticker-label">Restoration-ready supply</span></div>
		</section>

		<section id="catalogue" class="catalogue-section">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Find the right fit for your site</p>
					<h2>A little more <em>native.</em></h2>
				</div>
				<p class="section-intro">Browse our current range of trees, flaxes, grasses and ground-covering plants. Stock and grades can vary by season—get in touch to plan your quantities.</p>
			</div>

			<div class="catalogue-tools">
				<div class="category-filters" role="group" aria-label="Filter plants by category">
					<button class="filter-button is-active" type="button" data-category-filter="all" aria-pressed="true">All plants <span>{plantCatalog.length}</span></button>
					{plantCategories.map((category) => (
						<button class="filter-button" type="button" data-category-filter={category.name} aria-pressed="false">
							{category.name}<span>{plantCatalog.filter((plant) => plant.category === category.name).length}</span>
						</button>
					))}
				</div>
				<label class="search-box">
					<svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
					<span class="sr-only">Search native plants</span>
					<input id="plant-search" type="search" placeholder="Search plants…" autocomplete="off" />
					<kbd>/</kbd>
				</label>
			</div>
			<p id="catalogue-status" class="catalogue-status" aria-live="polite">Showing all {plantCatalog.length} plants</p>

			<div id="plant-groups" class="plant-groups">
				{plantCategories.map((category) => {
					const plants = plantCatalog.filter((plant) => plant.category === category.name);
					const id = categoryId(category.name);
					return (
						<section class="plant-group" id={id} data-plant-group={category.name} aria-labelledby={`${id}-heading`}>
							<div class="group-heading">
								<div class="group-heading-copy">
									<span class="group-index">{String(plantCategories.indexOf(category) + 1).padStart(2, '0')}</span>
									<div>
										<h3 id={`${id}-heading`}>{category.title}</h3>
										<p>{category.description}</p>
									</div>
								</div>
								<a href="#contact" class="group-link">Ask about availability <span aria-hidden="true">↗</span></a>
							</div>
							<div class="plant-grid">
								{plants.map((plant) => (
									<article
										class="plant-card"
										data-plant-card
										data-category={plant.category}
										data-search={`${plant.name} ${plant.category} ${plant.description}`.toLowerCase()}
									>
										<div class="plant-image">
											<img src={plant.image} alt={plant.imageAlt} width="720" height="540" loading="lazy" decoding="async" />
											<span class="plant-tag">{plant.category}</span>
										</div>
										<div class="plant-details">
											<h4>{plant.name}</h4>
											<p>{plant.description}</p>
										</div>
									</article>
								))}
							</div>
						</section>
					);
				})}
			</div>
			<div id="no-plants" class="empty-state" hidden>
				<p class="eyebrow">No plants found</p>
				<p>Try a different name or choose another category.</p>
				<button id="clear-search" class="text-link" type="button">Clear filters <span aria-hidden="true">↗</span></button>
			</div>
			<div class="range-footer">
				<p>Looking for something specific, or planning a larger order?</p>
				<a class="button button-outline" href={`mailto:${nurseryMeta.email}?subject=Native%20plant%20enquiry`}>Talk with the nursery <span aria-hidden="true">↗</span></a>
				<a class="guide-link" href={nurseryMeta.plantSelectionGuide} target="_blank" rel="noopener noreferrer">Open the plant selection guide <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section id="ellebag" class="ellebag-section">
			<div class="ellebag-image">
				<img src="https://dzpdbgwih7u1r.cloudfront.net/9aa59b48-85ec-4aad-8748-d7131ea253b0/a11b26df-c430-4dbb-8acc-e0c6a32309b5/a11b26df-c448-46dc-a6d9-6d11d2bfd881/w3024h3024-20230727_164422.jpg" alt="A WaiNot Native Nursery plant held in its Ellebag sleeve, with the roots visible" width="3024" height="3024" loading="lazy" decoding="async" />
				<span>A native plant, grown in its Ellebag sleeve.</span>
				<a class="ellebag-photo-credit" href="https://www.wainotnativenursery.co.nz/what-makes-us-different/" target="_blank" rel="noopener noreferrer">Photo: WaiNot Native Nursery <span aria-hidden="true">↗</span></a>
			</div>
			<div class="ellebag-copy">
				<p class="eyebrow">The WaiNot difference</p>
				<h2>Better roots.<br /><em>Lighter footprint.</em></h2>
				<p class="ellebag-intro">We grow in degradable Ellebags—designed to go into the ground with the plant. Less handling on planting day, less disposable packaging to manage.</p>
				<div class="benefit-list">
					<div><span>01</span><p><strong>Plant sleeve and all</strong><br />No decanting at the planting site.</p></div>
					<div><span>02</span><p><strong>Air-pruned roots</strong><br />Healthy, fibrous roots without spiralling.</p></div>
					<div><span>03</span><p><strong>Ready for the field</strong><br />Returnable corflute forestry boxes support practical transport.</p></div>
				</div>
				<a class="text-link light-link" href={nurseryMeta.ellebagGuide} target="_blank" rel="noopener noreferrer">Explore how Ellebags work <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="impact-section">
			<div class="impact-photo">
				<img src={plantCategories[2].image} alt="Native grasses and tussocks growing in a restoration landscape" width="495" height="446" loading="lazy" decoding="async" />
			</div>
			<div class="impact-copy">
				<p class="eyebrow">Grown for the long view</p>
				<h2>Small plants.<br /><em>Lasting impact.</em></h2>
				<p>From healthier waterways and wetlands to stronger native habitats, the plants we grow help restore the places we all depend on.</p>
				<div class="impact-stat"><span>250k</span><p>native plants supplied into communities and the New Zealand landscape</p></div>
				<a class="text-link" href="#contact">Let’s plan your project <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="trust-section" id="sustainability">
			<div class="trust-mark">
				<img src="https://dzpdbgwih7u1r.cloudfront.net/9aa59b48-85ec-4aad-8748-d7131ea253b0/a080730c-18af-4b77-b271-ab1e612e7301/a080730c-18ce-400f-840e-2b678e534826/w1000h536-PP-CP-logo-green.fw.png" alt="Plant Pass certified nursery" width="240" height="129" loading="lazy" decoding="async" />
			</div>
			<div class="trust-copy">
				<p class="eyebrow">Growing with care</p>
				<h2>Good plants start<br />with <em>good practice.</em></h2>
				<p>Plant Pass certification recognises our nursery standards for plant health, biosecurity and traceability—helping protect customers, the environment and Aotearoa’s plant supply chains.</p>
				<a class="text-link" href="https://plantpass.org.nz/" target="_blank" rel="noopener noreferrer">About Plant Pass <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="nursery-story" aria-labelledby="nursery-story-title">
			<div class="nursery-story-heading">
				<div>
					<p class="eyebrow">A little more about us</p>
					<h2 id="nursery-story-title">People, place<br />and <em>purpose.</em></h2>
				</div>
				<div class="nursery-story-intro">
					<p>WaiNot is a family-run nursery in Waikite Valley. Get a glimpse of the people, growing systems and place behind every plant.</p>
					<a class="text-link" href={siteUrl('what-makes-us-different/')}>Meet WaiNot Native Nursery <span aria-hidden="true">↗</span></a>
				</div>
			</div>
			<div class="nursery-story-grid">
				{nurseryStoryPhotos.map((photo) => (
					<figure class={`nursery-photo-card nursery-photo-card--${photo.id}`}>
						<img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
						<figcaption><span>{photo.caption}</span><span aria-hidden="true">↗</span></figcaption>
					</figure>
				))}
			</div>
		</section>

		<section id="testimonials" class="testimonial-section">
			<div class="testimonial-heading">
				<p class="eyebrow">Good things grow together</p>
				<h2>From the people<br />doing the <em>planting.</em></h2>
			</div>
			<div class="testimonial-panel">
				<div class="quote-mark" aria-hidden="true">“</div>
				<div id="testimonial-quotes" class="testimonial-quotes" aria-live="polite" aria-atomic="true">
					{testimonials.map((testimonial, index) => (
						<figure class="testimonial-quote" data-quote={index} hidden={index !== 0}>
							<blockquote>{testimonial.text}</blockquote>
							<figcaption>{testimonial.author}</figcaption>
						</figure>
					))}
				</div>
				<div class="testimonial-controls">
					<p><span id="quote-index">01</span> <span class="quote-total">/ {String(testimonials.length).padStart(2, '0')}</span></p>
					<div>
						<button type="button" id="quote-previous" aria-label="Previous testimonial" aria-controls="testimonial-quotes">←</button>
						<button type="button" id="quote-next" aria-label="Next testimonial" aria-controls="testimonial-quotes">→</button>
					</div>
				</div>
			</div>
		</section>

		<section id="contact" class="contact-section">
			<div class="contact-copy">
				<p class="eyebrow">Your next planting starts here</p>
				<h2>Let’s grow<br /><em>something good.</em></h2>
				<p>Planning a project? Tell us where you’re planting and what you need. We’re happy to help you find the right plants for your site.</p>
				<div class="contact-actions">
					<a class="button button-light" href={`mailto:${nurseryMeta.email}?subject=Native%20plant%20enquiry`}>Email the nursery <span aria-hidden="true">↗</span></a>
					<a class="contact-phone" href={`tel:${nurseryMeta.phoneSteph}`}>Or call Steph · 027 291 6064</a>
				</div>
			</div>
			<div class="contact-details">
				<div><span>Visit by appointment</span><p>{nurseryMeta.address}</p><a href="https://maps.google.com/?q=715+Waikite+Valley+Road,+Rotorua" target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a></div>
				<div><span>Talk to the team</span><p><a href={`tel:${nurseryMeta.phoneSteph}`}>027 291 6064 · Steph</a><br /><a href={`tel:${nurseryMeta.phoneSteve}`}>027 475 1612 · Steve</a></p></div>
				<div><span>Write to us</span><p><a href={`mailto:${nurseryMeta.email}`}>{nurseryMeta.email}</a></p></div>
				<div><span>Open</span><p>By appointment<br />Please phone ahead</p></div>
			</div>
		</section>
	</div>

	<script>
		const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
		const plantCards = Array.from(document.querySelectorAll<HTMLElement>('[data-plant-card]'));
		const plantGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-plant-group]'));
		const searchInput = document.querySelector<HTMLInputElement>('#plant-search');
		const status = document.querySelector<HTMLElement>('#catalogue-status');
		const emptyState = document.querySelector<HTMLElement>('#no-plants');
		const clearButton = document.querySelector<HTMLButtonElement>('#clear-search');
		let selectedCategory = 'all';

		const updateCatalogue = () => {
			const query = searchInput?.value.trim().toLowerCase() ?? '';
			let visibleCount = 0;

			for (const card of plantCards) {
				const matchesCategory = selectedCategory === 'all' || card.dataset.category === selectedCategory;
				const matchesSearch = query.length === 0 || (card.dataset.search ?? '').includes(query);
				const visible = matchesCategory && matchesSearch;
				card.hidden = !visible;
				if (visible) visibleCount += 1;
			}

			for (const group of plantGroups) {
				group.hidden = !group.querySelector('[data-plant-card]:not([hidden])');
			}

			if (status) status.textContent = `Showing ${visibleCount} of ${plantCards.length} plants`;
			if (emptyState) emptyState.hidden = visibleCount > 0;
		};

		for (const button of filterButtons) {
			button.addEventListener('click', () => {
				selectedCategory = button.dataset.categoryFilter ?? 'all';
				for (const filter of filterButtons) {
					const active = filter === button;
					filter.classList.toggle('is-active', active);
					filter.setAttribute('aria-pressed', String(active));
				}
				updateCatalogue();
			});
		}

		searchInput?.addEventListener('input', updateCatalogue);
		clearButton?.addEventListener('click', () => {
			if (searchInput) searchInput.value = '';
			selectedCategory = 'all';
			for (const filter of filterButtons) {
				const active = filter.dataset.categoryFilter === 'all';
				filter.classList.toggle('is-active', active);
				filter.setAttribute('aria-pressed', String(active));
			}
			updateCatalogue();
			searchInput?.focus();
		});

		document.addEventListener('keydown', (event) => {
			const target = event.target;
			const isEditing = target instanceof HTMLElement
				&& (target.isContentEditable || Boolean(target.closest('input, textarea, select, [contenteditable="true"]')));
			if (event.key === '/' && !isEditing && !event.altKey && !event.ctrlKey && !event.metaKey) {
				event.preventDefault();
				searchInput?.focus();
			}
		});

		const quotes = Array.from(document.querySelectorAll<HTMLElement>('[data-quote]'));
		const quoteIndex = document.querySelector<HTMLElement>('#quote-index');
		let activeQuote = 0;
		const showQuote = (index: number) => {
			activeQuote = (index + quotes.length) % quotes.length;
			for (const [quoteNumber, quote] of quotes.entries()) quote.hidden = quoteNumber !== activeQuote;
			if (quoteIndex) quoteIndex.textContent = String(activeQuote + 1).padStart(2, '0');
		};

		document.querySelector('#quote-previous')?.addEventListener('click', () => showQuote(activeQuote - 1));
		document.querySelector('#quote-next')?.addEventListener('click', () => showQuote(activeQuote + 1));
	</script>

	<style>
		:global(:root) {
			--ink: #1d3229;
			--forest: #244437;
			--moss: #829477;
			--sage: #dce4d6;
			--cream: #f5f4ee;
			--paper: #fcfbf7;
			--muted: #69766d;
			--line: rgba(29, 50, 41, 0.14);
			--text-caption: 0.75rem;
			--text-small: 0.875rem;
			--text-body: 1rem;
			--text-lead: 1.125rem;
			--display: "Playfair Display", Georgia, serif;
			--sans: "Inter", Arial, sans-serif;
		}

		:global(html) { scroll-behavior: smooth; scroll-padding-top: 88px; }
		:global(body) { font-family: var(--sans); background: var(--paper); color: var(--ink); }
		:global(::selection) { background: #bdcdb5; color: var(--ink); }
		:global(.sr-only) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
		:global([hidden]) { display: none !important; }
		:global(:focus-visible) { outline: 3px solid #91a77f; outline-offset: 3px; }

		.nursery-home { overflow: hidden; }
		.hero { min-height: 640px; padding: clamp(64px, 8vw, 110px) var(--gutter); display: grid; grid-template-columns: 1fr .82fr; align-items: center; gap: clamp(36px, 7vw, 112px); background: radial-gradient(ellipse at 85% 10%, rgba(216, 225, 207, .55), transparent 37%), var(--cream); }
		.hero-copy { max-width: 630px; padding: 16px 0; }
		.eyebrow { margin: 0 0 20px; color: #687d64; font-size: var(--text-caption); font-weight: 700; letter-spacing: .16em; line-height: 1.5; text-transform: uppercase; }
		.eyebrow-dot { display: inline-block; width: 7px; height: 7px; margin: 0 8px 1px 0; border-radius: 50%; background: #8a9f75; }
		.hero h1, .section-heading h2, .ellebag-copy h2, .impact-copy h2, .trust-copy h2, .testimonial-heading h2, .contact-copy h2 { margin: 0; color: var(--ink); font-family: var(--display); font-weight: 500; letter-spacing: -.055em; }
		.hero h1 { font-size: clamp(3.375rem, 6.5vw, 6rem); line-height: .99; }
		.hero h1 em, .section-heading h2 em, .ellebag-copy h2 em, .impact-copy h2 em, .trust-copy h2 em, .testimonial-heading h2 em, .contact-copy h2 em { color: #809174; font-weight: 400; }
		.hero-intro { max-width: 465px; margin: 26px 0 0; color: #667168; font-size: clamp(var(--text-body), 1.25vw, var(--text-lead)); line-height: 1.75; }
		.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 25px; margin-top: 30px; }
		.button { min-height: 50px; padding: 0 21px; display: inline-flex; align-items: center; justify-content: center; gap: 20px; border-radius: 3px; font-size: var(--text-small); font-weight: 600; text-decoration: none; box-shadow: 0 7px 18px rgba(36, 68, 55, .13); transition: transform .2s ease, background .2s ease, box-shadow .2s ease; }
		.button:hover { transform: translateY(-2px); }
		.button-dark { background: var(--forest); color: white; }
		.button-dark:hover { background: #192f25; }
		.text-link { color: var(--ink); font-size: var(--text-small); font-weight: 600; text-decoration: none; border-bottom: 1px solid #a7b19e; padding-bottom: 5px; }
		.text-link:hover, .guide-link:hover, .group-link:hover { color: #829477; }
		.text-link span { padding-left: 8px; }
		.hero-proof { display: flex; align-items: center; gap: 14px; margin-top: 58px; padding-top: 20px; border-top: 1px solid var(--line); }
		.proof-number { color: var(--forest); font-family: var(--display); font-size: 38px; letter-spacing: -.06em; line-height: 1; }
		.proof-number span { color: #829477; }
		.proof-copy, .proof-note { color: #68736a; font-size: var(--text-caption); line-height: 1.6; }
		.proof-divider { width: 1px; height: 30px; margin: 0 7px; background: var(--line); }
		.hero-visual { position: relative; width: 100%; max-width: 540px; justify-self: end; }
		.hero-visual::before { position: absolute; z-index: 0; top: -18px; right: -18px; width: 40%; height: 48%; content: ""; background: #d9e0d1; }
		.hero-photo { position: relative; z-index: 1; display: block; width: 100%; height: clamp(440px, 49vw, 640px); object-fit: cover; object-position: center 52%; box-shadow: 0 22px 48px rgba(27, 48, 37, .12); }
		.photo-caption { position: absolute; z-index: 2; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-between; gap: 12px; padding: 40px 18px 16px; background: linear-gradient(transparent, rgba(20, 39, 29, .74)); color: white; font-size: var(--text-caption); letter-spacing: .04em; }
		.photo-stamp { position: absolute; z-index: 2; top: 22px; left: -31px; width: 84px; height: 84px; display: grid; place-items: center; border-radius: 50%; background: #f7f5eb; color: var(--forest); box-shadow: 0 5px 20px #18281d20; }
		.photo-stamp svg { position: absolute; inset: 4px; width: calc(100% - 8px); height: calc(100% - 8px); animation: stamp-rotate 24s linear infinite; fill: var(--forest); font-size: .5rem; letter-spacing: 1.6px; }
		.photo-stamp > span { font-family: var(--display); font-size: 2.25rem; font-style: italic; }
		@keyframes stamp-rotate { to { transform: rotate(360deg); } }
		.ticker { padding: 0 var(--gutter); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid rgba(255,255,255,.14); background: var(--forest); }
		.ticker div { min-width: 0; min-height: 100px; padding: 18px 20px; display: grid; align-content: start; justify-items: start; gap: 9px; color: #f5f4ee; font-size: var(--text-small); font-weight: 500; line-height: 1.45; }
		.ticker div + div { border-left: 1px solid rgba(255,255,255,.18); }
		.ticker span { color: #c8d6b9; font-family: var(--display); font-size: 1rem; font-style: italic; line-height: 1; }
		.ticker .ticker-label { color: #f5f4ee; font-family: var(--sans); font-size: var(--text-small); font-style: normal; font-weight: 500; line-height: 1.45; }

